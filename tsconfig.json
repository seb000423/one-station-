{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@one-twin/schema": ["packages/schema/src/index.ts"], "@one-twin/core": ["packages/core/src/index.ts"], "@one-twin/engine": ["packages/engine/src/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test", "tools/one-twin/*.ts"]
}
